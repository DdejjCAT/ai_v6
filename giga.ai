{
  "url": "https://giga.chat/api/smartproxy/api/prelogin/api/v0/sessions/request",
  "method": "POST",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:151.0) Gecko/20100101 Firefox/151.0",
    "Accept": "text/event-stream, application/json, text/event-stream",
    "Accept-Language": "ru-RU,ru;q=0.9,en-US;q=0.8,en;q=0.7",
    "Accept-Encoding": "gzip, deflate, br, zstd",
    "Referer": "https://giga.chat/",
    "Content-Type": "application/json",
    "X-User-Timezone": "Asia/Yekaterinburg",
    "x-request-id": "{{UUID}}",
    "x-project-id": "019e9457-6318-76c9-a3fe-7a793b3fb2d5",
    "x-sm-user-id": "019e9457-60a5-787f-9e13-704c71838e8e",
